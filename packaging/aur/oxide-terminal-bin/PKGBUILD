# Maintainer: Bobby Coleman <bobbycoleman.dev@gmail.com>
#
# Binary package from the GitHub release tarball. scripts/release-linux.sh
# bumps pkgver and the checksum after each release; regenerate .SRCINFO with
# `makepkg --printsrcinfo > .SRCINFO` before pushing to the AUR.
pkgname=oxide-terminal-bin
pkgver=0.6.3
pkgrel=1
pkgdesc="A native, GPU-rendered terminal emulator with a vim-driven file tree drawer, splits and workspaces"
arch=('x86_64')
url="https://oxideterminal.com"
license=('MIT')
depends=('gcc-libs' 'glibc' 'libxcb' 'libxau' 'libxdmcp' 'libxkbcommon' 'libxkbcommon-x11'
         'wayland' 'vulkan-icd-loader' 'libnotify' 'hicolor-icon-theme')
optdepends=('vulkan-radeon: Vulkan driver for AMD GPUs'
            'vulkan-intel: Vulkan driver for Intel GPUs'
            'nvidia-utils: Vulkan driver for NVIDIA GPUs'
            'vulkan-swrast: software Vulkan, for machines with no GPU driver'
            'xdg-utils: open links in the browser')
provides=('oxide-terminal')
conflicts=('oxide-terminal')
source=("https://github.com/oxide-terminal/oxide/releases/download/v${pkgver}/oxide-${pkgver}-linux-x86_64.tar.gz")
sha256sums=('82bc93879a57d470f398c8759a08ace0d5db31ab711a8432f303f0b0036aae71')

package() {
  cd "oxide-${pkgver}-linux-x86_64"
  install -Dm755 oxide "$pkgdir/usr/bin/oxide"
  install -Dm644 oxide.desktop "$pkgdir/usr/share/applications/oxide.desktop"
  for png in icons/hicolor/*/apps/oxide.png; do
    size="$(basename "$(dirname "$(dirname "$png")")")"
    install -Dm644 "$png" "$pkgdir/usr/share/icons/hicolor/$size/apps/oxide.png"
  done
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
